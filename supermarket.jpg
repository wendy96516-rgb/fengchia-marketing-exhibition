        background: #f0b3b4;
        }

/*--google搜尋樣式--*/
.gsc-control-wrapper-cse button {
    padding: 5px 18px !important;
  }
  
.gsc-control-wrapper-cse td {
    border: none !important;
}

.gsc-control-wrapper-cse table {
    margin: 0 !important;
} 

 
/*--最後更新日期--*/
p.post-modified-info {
	font-size: 0.8rem;
}


/*--旅宿文末簡潔版--*/
.hotel-info{
	  margin: 0px;
    padding: 10px 20px;
    border: 1px solid #dedede;
    border-radius: 5px;}

/*--懶人包7隱藏整區.字體大小--*/
.blogimove-CPC-ARTICLE-BOSTON .entry-header {display:none;}
.blogimove-CPC-ARTICLE-BOSTON {font-size:1rem;} 


/*--HR分隔線--*/
.hr-dashed {
    height: 12px; 
	  border: 0; 
	  border-bottom: 1px dashed #ccc;"
}


/*--短代碼的項目清單--*/
.ul-shortercode {
	list-style-type: '\1F44D';
	text-indent: 10px;
	font-size:1rem;
}
.ul-shortercode2 {
	list-style-type: '\2708';
	text-indent: 10px;
	font-size:1rem;
}
.ul-shortercode3 {
	text-indent: 10px;
	font-size:1rem;
}

/*--短代碼的H3標題樣式--*/
.sc-h3{
    font-weight: 600;
    border-bottom: 1px #ccc dotted;}

.sc-h3 span {
    display: inline-block;
    padding: 5px 15px;
    background: linear-gradient(190deg, rgba(166,148,169,0) 0%, rgba(166,148,169,0) 65%, rgba(166,148,169,0.5) 50%, rgba(166,148,169,0.5) 100%);}


/*--文內延伸閱讀--*/
.related-article a {
   	color: #be9924;
    text-decoration: none;}

.related-article {
    font-size:1rem;
	  background: #f8f5ef;
    border-radius: 50px;
    margin: 50px 20px;
    padding: 25px 40px;
    position: relative;
    text-decoration: none;
} 
 

/*--tablepress表格樣式--*/
.tablepress tfoot th, .tablepress thead th{
    background-color: #d2c9d4;
    text-align: center;}
.tablepress a{
    color: #ffffff;
    background-color: #ef9fbf;
    padding: 2px 10px;
    text-decoration: none;
